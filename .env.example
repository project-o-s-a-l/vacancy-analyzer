# Local development only. Replace the password before exposing PostgreSQL.
POSTGRES_DB=vacancies
POSTGRES_USER=vacancies
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vacancies:local-development-only@localhost:5432/vacancies
# Results stay on stdout; diagnostics go to stderr and managed JSONL files.
# Incident lookup, access and cleanup: docs/ARCHITECTURE.md.
# INFO/DEBUG include one scalar catalogue diagnostic query per candidate selection.
# DEBUG still excludes resume/profile values, prompts, responses, URLs and credentials.
LOG_LEVEL=INFO
# text: compact local-time lines; json: full UTC records. Files always retain full JSON.
LOG_CONSOLE_FORMAT=text
# Per-run JSONL files; shared directory/budget for all processes on this server.
# Use the same total budget for all processes. Keep the directory private.
# Closed-run TTL/budget cleanup is automatic; never delete live leases or logs.
LOG_FILE_ENABLED=true
LOG_DIRECTORY=data/logs
LOG_MAX_FILE_BYTES=5242880
LOG_BACKUP_COUNT=3
LOG_RETENTION_DAYS=7
LOG_TOTAL_MAX_BYTES=104857600
LOG_QUEUE_SIZE=256
LOG_SHUTDOWN_TIMEOUT=2
LOG_REPEAT_INTERVAL=60
LOG_REPEAT_KEYS=128
# Shared IT catalog; see docs/COLLECTION.md. Set COLLECTION_MODE=profiles for profile-driven HH.
COLLECTION_MODE=it
COLLECTION_SOURCES=["hh","habr_career","trudvsem","superjob"]
# Hourly request budgets for Habr Career and Trudvsem.
PUBLIC_SEARCH_REQUESTS_PER_HOUR=60
PUBLIC_DETAIL_REQUESTS_PER_HOUR=120
PUBLIC_REQUEST_DELAY=5
# SuperJob paces requests continuously. Search requests also use PUBLIC_REQUEST_DELAY.
SUPERJOB_DETAIL_TARGET_PER_HOUR=700
SUPERJOB_REQUEST_DELAY=2
# Avito discovery counts newly inserted publications per hour. Filtered ads only use requests.
AVITO_NEW_TARGET_PER_HOUR=500
AVITO_DETAIL_REQUESTS_PER_HOUR=720
AVITO_SEARCH_REQUESTS_PER_HOUR=180
AVITO_REQUEST_DELAY=2
HH_AUTO_COLLECT=false
# Set true to collect new source IDs and leave saved publications for a normal run.
COLLECTION_NEW_ONLY=false
HH_SOURCE=html
HH_SEARCH_REQUESTS_PER_HOUR=30
HH_DETAIL_REQUESTS_PER_HOUR=90
HH_BASE_URL=https://spb.hh.ru/
HH_REQUEST_DELAY=10
HH_POLL_INTERVAL=3600
HH_PROFILE_CHECK_INTERVAL=60
# Recheck saved vacancies every three days. Search for new IDs runs independently.
# Set HH_CHECK_LIMIT=0 to disable extra HTTP rechecks.
HH_CHECK_LIMIT=20
HH_CHECK_INTERVAL=259200
HH_CHECK_BATCH_INTERVAL=3600
HH_SNAPSHOTS_DIR=data/raw/hh
# No publication-age limit; closed, expired and future-dated cards are excluded.
# Local Ollama; no external API or key. Enable after starting the model service.
# Temporary smaller model; do not upgrade or download weights automatically.
VACANCY_LLM_ENABLED=false
RESUME_LLM_ENABLED=false
# Disable editing while retaining the compatible reader and saved facts.
PROFILE_EDITOR_ENABLED=true
# Whole resume analysis, separate from OLLAMA_TIMEOUT for a single request.
# On exhaustion, completed sections remain reviewable with explicit partial status.
RESUME_TOTAL_TIMEOUT=300
# Persisted analysis executor in the bot; set false when running a separate worker.
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_POLL_INTERVAL=5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180
# Per-request retention overrides server OLLAMA_KEEP_ALIVE; 0 disables retention.
OLLAMA_KEEP_ALIVE=30
INFERENCE_MIN_AVAILABLE_MB=4096
ANALYSIS_QUEUE_LIMIT=256
ANALYSIS_RESUME_RESERVE=32
ANALYSIS_RESUME_BURST=3
ANALYSIS_USER_PER_MINUTE=3
# These two settings are used only by the optional --source api mode.
HH_USER_AGENT=JobMarketAnalyzer/0.1 (your-email@example.com)
# Optional OAuth token; never commit a real token.
HH_ACCESS_TOKEN=
# Obtain a token from @BotFather. Keep it only in your local .env.
TELEGRAM_BOT_TOKEN=
# Each user registers with /start and fills in their own profile in the bot.
# Preview size for notify --dry-run. Telegram sends one card per rating.
TELEGRAM_TOP=5
# Only rules/shadow/fallback; model uses its calibrated rank/evidence admission (max 5).
TELEGRAM_MIN_SCORE=50
# rules: current order; shadow: compare only; model: requires a compatible approved artifact.
RANKER_MODE=rules
# Immutable serving-linear-v2 model.json with independent validation. See docs/BENCHMARK.md.
# No training or activation is performed automatically.
RANKER_MODEL_PATH=
# Reuse bounded rule-scoring pools; current catalogue/conditions/history are always checked.
SAVED_SELECTIONS_ENABLED=true
# Compact PostgreSQL Top-N; human quality acceptance remains pending.
RETRIEVAL_K=256
RETRIEVAL_POOL_FACTOR=4
RETRIEVAL_NORMALIZATION=coverage
# Portable rollback: compact + normalization=legacy; preserves bounded residual checks.
RETRIEVAL_BACKEND=sql
